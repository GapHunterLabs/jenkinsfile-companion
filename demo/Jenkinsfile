pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = 'registry.acme-corp.com'
        SERVICE_NAME = 'checkout-service'
    }

    stages {
        stage('Build') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
                junit 'target/surefire-reports/*.xml'
            }
        }

        stage('Package Image') {
            steps {
                sh "docker build -t ${DOCKER_REGISTRY}/${SERVICE_NAME}:${env.BUILD_NUMBER} ."
            }
        }

        stage('Deploy Staging') {
        }

        stage('Test') {
            steps {
                sh './scripts/run-integration-tests.sh --env=staging'
            }
        }
    }
}
